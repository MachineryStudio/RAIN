{
  "entities": {
    "user": {
      "title": "User Profile",
      "description": "User account information and preferences",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "language": { "type": "string", "enum": ["ja", "en", "fr", "es", "it", "ko", "zh"] },
        "selectedGenres": { "type": "array", "items": { "type": "string" } },
        "isAdmin": { "type": "boolean" },
        "isPremium": { "type": "boolean" },
        "raiTokens": { "type": "number" },
        "totalListenMinutes": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastActiveAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "language"]
    },
    "song": {
      "title": "Song",
      "description": "Metadata for an audio track",
      "type": "object",
      "properties": {
        "songId": { "type": "string" },
        "singerName": { "type": "object" },
        "songName": { "type": "object" },
        "streamUrl": { "type": "string" },
        "artistOfficialUrl": { "type": "string" },
        "albumArtUrl": { "type": "string" },
        "genres": { "type": "array", "items": { "type": "string" } },
        "tags": { "type": "array", "items": { "type": "string" } },
        "bpm": { "type": "number" },
        "playCount": { "type": "number" },
        "skipCount": { "type": "number" },
        "avgListenDuration": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "isActive": { "type": "boolean" }
      },
      "required": ["singerName", "songName", "streamUrl", "genres"]
    },
    "playlist": {
      "title": "Playlist",
      "description": "A collection of songs",
      "type": "object",
      "properties": {
        "playlistId": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "songIds": { "type": "array", "items": { "type": "string" } },
        "isPublic": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "name", "songIds"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "user",
      "description": "User profiles"
    },
    "songs/{songId}": {
      "schema": "song",
      "description": "Music library"
    },
    "playlists/{playlistId}": {
      "schema": "playlist",
      "description": "User playlists"
    }
  }
}
